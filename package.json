{
  "name": "radium",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RADIUM — planetary site suitability and Earth analog discovery (NASA Space Apps Challenge)",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,white \"npm:api\" \"npm:web\"",
    "web": "vite",
    "api": ".venv/bin/python -W ignore -m uvicorn backend.app:app --port 8000 --log-level warning --reload --reload-dir backend",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "test": ".venv/bin/python -m pytest tests -q",
    "pipeline": ".venv/bin/python -m pipeline.run_all",
    "assets": "node scripts/copy-assets.mjs",
    "predev": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs",
    "preweb": "node scripts/copy-assets.mjs",
    "api:prod": ".venv/bin/python -W ignore -m uvicorn backend.app:app --port 8000 --log-level warning",
    "snapshot": ".venv/bin/python -W ignore scripts/build_snapshot.py",
    "test:browser": "node tests/browser-workflows.mjs",
    "test:persistence": "node --test tests/test_persistence.mjs",
    "test:sharing": "node tests/browser-sharing.mjs",
    "test:maps-tutorial": "node tests/ui-maps-tutorial.mjs",
    "test:tour": "node tests/tour.mjs",
    "test:evidence": "node --test tests/test_assessment.mjs tests/test_earth_context.mjs",
    "test:upgrade": "node tests/tour.mjs && node tests/tour-field-guide.mjs && node tests/browser-console.mjs && node tests/browser-map-controls.mjs && node tests/browser-map-resilience.mjs && node tests/discovery-gallery.mjs && node tests/browser-earth-context.mjs && node tests/browser-starters.mjs && node tests/browser-mobile-sheet.mjs && node tests/browser-demos.mjs"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "cesium": "^1.147.0",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "^6.18.0",
    "puppeteer": "^25.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
